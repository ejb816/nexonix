type SelfDeclaration
domain draco Draco
rule
  pattern
    variables
      var d DomainType
    conditions
      con d.typeDefinition.domainAspect.typeName != d.typeDefinition.typeName
  action
    mon ctx.insert(Problem(d.typeDefinition.typeName, s"domain ${d.typeDefinition.typeName.name} does not self-declare: domainAspect.typeName is ${d.typeDefinition.domainAspect.typeName.name}"))
