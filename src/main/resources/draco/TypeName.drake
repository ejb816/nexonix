type TypeName
  elements
    fix name String
    fix namePackage [String]
    fix typeParameters [Json]
    fix namePath String
    fix resourcePath String
  factory
    parameters
      par name String
      par namePackage [String] []
      par typeParameters [Json] []
    body
      fix name String _name
      fix namePackage [String] _namePackage
      fix typeParameters [Json] _typeParameters
      fix namePath String if (namePackage.isEmpty) name else s"${namePackage.mkString(".")}.${name}"
      fix resourcePath String if (namePackage.isEmpty) s"/$name.json" else s"/${namePackage.mkString("/")}/$name.json"
      dyn equals Boolean [
        parameters
          now par other Any
        body
          case tn TypeName [
            fix value Boolean name == tn.name && namePackage == tn.namePackage && typeParameters == tn.typeParameters
          ]
          case [
            fix value Boolean false
          ]
      ]
      dyn hashCode Int (name, namePackage, typeParameters).hashCode
domain draco Draco
