type TypeName
  elements
    fix name String
    fix namePackage [String]
    fix typeParameters [Dracon]
    fix namePath String
    fix resourcePath String
  factory
    parameters
      par name String
      par namePackage [String] []
      par typeParameters [Dracon] []
    body
      fix name String _name
      fix namePackage [String] _namePackage
      fix typeParameters [Dracon] _typeParameters
      fix namePath String join(".", namePackage ++ [name])
      fix resourcePath String "/" ++ join("/", namePackage ++ [name ++ ".json"])
      dyn equals Boolean [
        parameters
          now par other Any
        body
          case tn TypeName [
            fix value Boolean name == tn.name && namePackage == tn.namePackage && typeParameters == tn.typeParameters
          ]
          case [
            fix value Boolean false
          ]
      ]
      dyn hashCode Int (name, namePackage, typeParameters).hashCode
  globals
    fix read (Dracon -> Presence(TypeName)) \source -> guard(source.isObject).ifThenElse(source.field("name").textOrEmpty.fold(Absent(), \name -> source.field("namePackage").textsOrEmpty.fold(Absent(), \parts -> source.field("typeParameters").itemsOrEmpty.fold(Absent(), \arguments -> Present(TypeName(name, parts, arguments))))), Absent())
    fix write (TypeName -> Dracon) \name -> Dracon.record(guard(name.name.nonEmpty).ifThenElse([("name", Dracon.string(name.name))], []) ++ guard(name.namePackage.nonEmpty).ifThenElse([("namePackage", Dracon.array(name.namePackage.map(Dracon.string)))], []) ++ guard(name.typeParameters.nonEmpty).ifThenElse([("typeParameters", Dracon.array(name.typeParameters))], []))
uses [
  draco drake Absent
  draco drake Presence
  draco drake Present
  draco format dracon Dracon
]
domain draco Draco
codec
  payload [typeParameters]
