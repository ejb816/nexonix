type TypeName
  elements
    fix name String
    fix namePackage [String]
    fix typeParameters [draco.format.dracon.Dracon]
    fix namePath String
    fix resourcePath String
  factory
    parameters
      par name String
      par namePackage [String] []
      par typeParameters [draco.format.dracon.Dracon] []
    body
      fix name String _name
      fix namePackage [String] _namePackage
      fix typeParameters [draco.format.dracon.Dracon] _typeParameters
      fix namePath String join(".", namePackage ++ [name])
      fix resourcePath String "/" ++ join("/", namePackage ++ [name ++ ".json"])
      dyn equals Boolean [
        parameters
          now par other Any
        body
          case tn TypeName [
            fix value Boolean name == tn.name && namePackage == tn.namePackage && typeParameters == tn.typeParameters
          ]
          case [
            fix value Boolean false
          ]
      ]
      dyn hashCode Int (name, namePackage, typeParameters).hashCode
  globals
    fix read (draco.format.dracon.Dracon -> draco.drake.Presence(TypeName)) \source -> guard(source.isObject).ifThenElse(source.field("name").textOrEmpty.fold(draco.drake.Absent(), \name -> source.field("namePackage").textsOrEmpty.fold(draco.drake.Absent(), \parts -> source.field("typeParameters").itemsOrEmpty.fold(draco.drake.Absent(), \arguments -> draco.drake.Present(TypeName(name, parts, arguments))))), draco.drake.Absent())
    fix write (TypeName -> draco.format.dracon.Dracon) \name -> draco.format.dracon.Dracon.record(guard(name.name.nonEmpty).ifThenElse([("name", draco.format.dracon.Dracon.string(name.name))], []) ++ guard(name.namePackage.nonEmpty).ifThenElse([("namePackage", draco.format.dracon.Dracon.array(name.namePackage.map(draco.format.dracon.Dracon.string)))], []) ++ guard(name.typeParameters.nonEmpty).ifThenElse([("typeParameters", draco.format.dracon.Dracon.array(name.typeParameters))], []))
domain draco Draco
codec
  payload [typeParameters]
