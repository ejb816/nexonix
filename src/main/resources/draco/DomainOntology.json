{
  "typeName": {
    "name": "DomainOntology",
    "namePackage": [
      "draco"
    ]
  },
  "dracoAspect": {
    "derivation": [
      {
        "name": "Dictionary",
        "namePackage": [
          "draco"
        ],
        "typeParameters": [
          "DomainType",
          "TypeDictionary"
        ]
      }
    ],
    "elements": [
      {
        "kind": "Fixed",
        "name": "derivations",
        "valueType": {
          "[]": [
            "Derivation"
          ]
        }
      },
      {
        "kind": "Dynamic",
        "name": "owns",
        "valueType": "Boolean",
        "parameters": [
          {
            "kind": "Parameter",
            "name": "domain",
            "valueType": "DomainType"
          },
          {
            "kind": "Parameter",
            "name": "typeName",
            "valueType": "TypeName"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": "Boolean",
            "value": {
              "||": [
                {
                  "==": [
                    "domain.typeDefinition.typeName.namePath",
                    "typeName.namePath"
                  ]
                },
                {
                  "()": [
                    "domain.typeDictionary.elementTypes.exists",
                    {
                      "\\": [
                        "td",
                        {
                          "==": [
                            "td.typeName.namePath",
                            "typeName.namePath"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "defines",
        "valueType": "Boolean",
        "parameters": [
          {
            "kind": "Parameter",
            "name": "typeName",
            "valueType": "TypeName"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": "Boolean",
            "value": {
              "()": [
                "kvMap.keys.exists",
                {
                  "\\": [
                    "domain",
                    {
                      "()": [
                        "owns",
                        "domain",
                        "typeName"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "dependencies",
        "valueType": {
          "[]": [
            "DomainType"
          ]
        },
        "parameters": [
          {
            "kind": "Parameter",
            "name": "domain",
            "valueType": "DomainType"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": {
              "[]": [
                "DomainType"
              ]
            },
            "value": {
              ".": [
                {
                  "()": [
                    "kvMap.keys.filter",
                    {
                      "\\": [
                        "other",
                        {
                          "&&": [
                            {
                              "!=": [
                                "other.typeDefinition.typeName",
                                "domain.typeDefinition.typeName"
                              ]
                            },
                            {
                              "()": [
                                "derivations.exists",
                                {
                                  "\\": [
                                    "edge",
                                    {
                                      "&&": [
                                        {
                                          "()": [
                                            "owns",
                                            "domain",
                                            "edge.child"
                                          ]
                                        },
                                        {
                                          "()": [
                                            "owns",
                                            "other",
                                            "edge.parent"
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "toSeq"
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "including",
        "valueType": "DomainOntology",
        "parameters": [
          {
            "kind": "Parameter",
            "name": "domain",
            "valueType": "DomainType"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": "DomainOntology",
            "value": {
              "()": [
                "DomainOntology",
                {
                  "++": [
                    "kvMap.keys.toSeq",
                    {
                      "[]": [
                        "domain"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "factory": {
      "kind": "Factory",
      "valueType": "DomainOntology",
      "parameters": [
        {
          "kind": "Parameter",
          "name": "domains",
          "valueType": {
            "[]": [
              "DomainType"
            ]
          },
          "value": {
            "[]": [
            ]
          }
        }
      ],
      "body": [
        {
          "kind": "Fixed",
          "name": "kvMap",
          "valueType": {
            "{}": [
              "DomainType",
              "TypeDictionary"
            ]
          },
          "value": {
            ".": [
              {
                "()": [
                  "_domains.map",
                  {
                    "\\": [
                      "domain",
                      {
                        "(,)": [
                          "domain",
                          "domain.typeDictionary"
                        ]
                      }
                    ]
                  }
                ]
              },
              "toMap"
            ]
          }
        },
        {
          "kind": "Fixed",
          "name": "derivations",
          "valueType": {
            "[]": [
              "Derivation"
            ]
          },
          "value": {
            "()": [
              "_domains.flatMap",
              {
                "\\": [
                  "domain",
                  {
                    "()": [
                      {
                        ".": [
                          {
                            "()": [
                              "domain.typeDictionary.elementTypes.prepended",
                              "domain.typeDefinition"
                            ]
                          },
                          "flatMap"
                        ]
                      },
                      {
                        "\\": [
                          "td",
                          {
                            "()": [
                              {
                                ".": [
                                  {
                                    "()": [
                                      "DracoAspect.parents",
                                      "td.dracoAspect"
                                    ]
                                  },
                                  "map"
                                ]
                              },
                              {
                                "\\": [
                                  "parent",
                                  {
                                    "()": [
                                      "Derivation",
                                      "td.typeName",
                                      "parent"
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "domainAspect": {
    "typeName": {
      "name": "Draco",
      "namePackage": [
        "draco"
      ]
    }
  }
}
