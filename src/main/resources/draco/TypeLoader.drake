type TypeLoader
  globals
    dyn readDefinition Presence(TypeDefinition) [
      parameters
        now par url URL
      body
        fix value Presence(TypeDefinition) presence(bracket(scala.io.Source.fromURL(url), \s -> s.close(), \s -> io.circe.parser.parse(s.mkString).flatMap(_.as[TypeDefinition]).toOption))
    ]
    dyn loadFromResource Presence(TypeDefinition) [
      parameters
        par resourcePath String
      body
        fix value Presence(TypeDefinition) DefinitionPath.default.source(resourcePath).fold(Absent(), readDefinition)
    ]
    dyn tryLoad Presence(TypeDefinition) [
      parameters
        par typeName TypeName
      body
        fix value Presence(TypeDefinition) loadFromResource(typeName.resourcePath)
    ]
    dyn rooted TypeDefinition [
      parameters
        now par td TypeDefinition
      body
        fix value TypeDefinition guard(DracoAspect.parents(td.dracoAspect).nonEmpty || td.typeName.name == "DracoType" && td.typeName.namePackage == Seq("draco")).ifThenElse(td, TypeDefinition(_typeName = td.typeName, _uses = td.uses, _dracoAspect = DracoAspect(_typeParameters = td.dracoAspect.typeParameters, _superDomain = td.dracoAspect.superDomain, _modules = td.dracoAspect.modules, _extensible = td.dracoAspect.extensible, _derivation = td.dracoAspect.derivation :+ TypeName.write(TypeName("DracoType", _namePackage = Seq("draco"))), _elements = td.dracoAspect.elements, _factory = td.dracoAspect.factory, _globalElements = td.dracoAspect.globalElements), _domainAspect = td.domainAspect, _ruleAspect = td.ruleAspect, _actorAspect = td.actorAspect, _codecAspect = td.codecAspect))
    ]
    dyn loadType TypeDefinition [
      parameters
        par typeName TypeName
      body
        fix value TypeDefinition tryLoad(typeName).fold(TypeDefinition(typeName), rooted)
    ]
    dyn isStub Boolean [
      parameters
        par typeName TypeName
      body
        loc td TypeDefinition loadType(typeName)
        fix value Boolean DracoAspect.isEmpty(td.dracoAspect) && DomainAspect.isEmpty(td.domainAspect) && td.ruleAspect.fold(true, \aspect -> false) && td.actorAspect.fold(true, \aspect -> false)
    ]
uses [
  draco drake Absent
  draco drake Presence
  draco generator carrier DefinitionPath
]
domain draco Draco
