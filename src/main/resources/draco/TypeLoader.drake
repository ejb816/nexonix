type TypeLoader
  globals
    dyn definitionSources [URL] [
      parameters
        par resourcePath String
      = scala.jdk.CollectionConverters.EnumerationHasAsScala(getClass.getClassLoader.getResources(resourcePath.stripPrefix("/"))).asScala.toSeq
    ]
    dyn readDefinition Option(TypeDefinition) [
      parameters
        par url URL
      = Option(url).flatMap { u => val source = scala.io.Source.fromURL(u); try io.circe.parser.parse(source.mkString).flatMap(_.as[TypeDefinition]).toOption finally source.close() }
    ]
    dyn loadFromResource Option(TypeDefinition) [
      parameters
        par resourcePath String
      = definitionSources(resourcePath) match { case Seq() => None case Seq(url) => readDefinition(url) case many => sys.error(s"draco: $resourcePath is defined at ${many.size} sources, and a type name must resolve to exactly one definition: " + many.mkString(", ")) }
    ]
    dyn tryLoad Option(TypeDefinition) [
      parameters
        par typeName TypeName
      = loadFromResource(typeName.resourcePath)
    ]
    dyn rooted TypeDefinition [
      parameters
        par td TypeDefinition
      = if (td.dracoAspect.derivation.nonEmpty || (td.typeName.name == "DracoType" && td.typeName.namePackage == Seq("draco"))) td else TypeDefinition(_typeName = td.typeName, _dracoAspect = DracoAspect(_superDomain = td.dracoAspect.superDomain, _modules = td.dracoAspect.modules, _extensible = td.dracoAspect.extensible, _derivation = Seq(TypeName("DracoType", _namePackage = Seq("draco"))), _elements = td.dracoAspect.elements, _factory = td.dracoAspect.factory, _globalElements = td.dracoAspect.globalElements, _source = td.dracoAspect.source, _target = td.dracoAspect.target), _domainAspect = td.domainAspect, _ruleAspect = td.ruleAspect, _actorAspect = td.actorAspect, _codecAspect = td.codecAspect)
    ]
    dyn loadType TypeDefinition [
      parameters
        par typeName TypeName
      = tryLoad(typeName).map(rooted).getOrElse(TypeDefinition(typeName))
    ]
domain draco Draco
