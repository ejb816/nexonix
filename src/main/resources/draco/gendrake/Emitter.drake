type Emitter
  factory ActorType
    parameters
      par received [Emission]+
uses [
  draco ActorType
  draco generator Emission
]
domain draco gendrake GenDrake
actor
  messageType draco TypeDefinition
  start
    fix session org.evrete.api.StatefulSession knowledge.newStatefulSession()
    mon session.set("received", received)
  message
    mon session.insert(Seq(msg): _*)
    mon session.fire()
  signal
    mon session.close()
