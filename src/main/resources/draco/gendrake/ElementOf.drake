type ElementOf
  elements
    fix lines [Text]
  factory
    parameters
      par element TypeElement
      par level Int
    body
      loc element TypeElement _element
      loc level Int _level
      loc formal (TypeParameter -> Text) \p -> FormalOf(p).value
      loc given [TypeParameter] element.typeParameters
      loc name Text element.name ++ guard(given.isEmpty).ifThenElse("", "(" ++ join(", ", given.map(formal)) ++ ")")
      loc kind Text element.typeDefinition.typeName.name
      loc step Text "  "
      loc pad (Int -> Text) \depth -> step * depth
      loc indent Text pad(level)
      loc keyword Text guard(element.now).ifThenElse(Keyword.strict ++ " ", "") ++ Keyword.table.getOrElse(kind, "")
      loc slotted (Dracon -> Text) \form -> SlotOf(form).value
      loc slot Text slotted(element.valueType)
      loc spelled (Dracon -> Text) \node -> ExpressionOf(node).value
      loc rendered Text spelled(element.value)
      loc valued (Text -> Text) \prefix -> guard(rendered == "").ifThenElse(prefix, prefix ++ " " ++ rendered)
      loc bare Boolean kind == "Monadic" || kind == "Condition"
      loc leaf [Text] [valued(guard(bare).ifThenElse(indent ++ keyword, indent ++ keyword ++ " " ++ name ++ " " ++ slot))]
      loc nested ((TypeElement, Int) -> [Text]) \member depth -> ElementOf(member, depth).lines
      loc section ((Text, [TypeElement]) -> [Text]) \head members -> guard(members.isEmpty).ifThenElse([], [indent ++ step ++ head] ++ members.flatMap(\member -> nested(member, level + 2)))
      loc method [Text] [indent ++ keyword ++ " " ++ name ++ " " ++ slot ++ " ["] ++ section("parameters", element.parameters) ++ section("body", element.body) ++ [indent ++ "]"]
      loc head [Text] [indent ++ keyword] ++ guard(element.name == "").ifThenElse([], [element.name]) ++ guard(slot == "").ifThenElse([], [slot]) ++ ["["]
      loc branch [Text] [join(" ", head)] ++ element.body.flatMap(\member -> nested(member, level + 1)) ++ [indent ++ "]"]
      loc block Boolean kind == "Dynamic" && (element.parameters.nonEmpty || element.body.nonEmpty)
      fix lines [Text] guard(kind == "Case").ifThenElse(branch, guard(block).ifThenElse(method, leaf))
uses [
  draco TypeElement
  draco TypeParameter
  draco drake Text
  draco draketarget Keyword
  draco format dracon Dracon
]
domain draco gendrake GenDrake
