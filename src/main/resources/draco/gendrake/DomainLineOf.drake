type DomainLineOf from draco draketarget DomainLine
  factory
    parameters
      par definition TypeDefinition
    body
      loc definition TypeDefinition _definition
      loc line DomainLine DomainLine(definition.domainAspect.typeName.namePackage, definition.domainAspect.typeName.name)
      fix value draco.drake.Text line.value
domain draco gendrake GenDrake
