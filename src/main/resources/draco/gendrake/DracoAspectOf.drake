type DracoAspectOf from draco draketarget DracoAspectText
  factory
    parameters
      par definition TypeDefinition
      par elementText ((TypeElement, Int) -> [Text])
    body
      loc definition TypeDefinition _definition
      loc elementText ((TypeElement, Int) -> [Text]) _elementText
      loc aspect DracoAspect definition.dracoAspect
      loc typed (Dracon -> Text) \form -> TypeFormOf(form).value
      loc slot (Dracon -> Text) \form -> SlotOf(form).value
      loc appliedName (TypeName -> Text) \name -> name.name ++ guard(name.typeParameters.isEmpty).ifThenElse("", "(" ++ join(", ", name.typeParameters.map(typed)) ++ ")")
      loc reference (TypeName -> Text) \name -> guard(name.namePackage == definition.typeName.namePackage).ifThenElse(appliedName(name), join(" ", name.namePackage ++ [appliedName(name)]))
      loc root (TypeName -> Boolean) \name -> name.name == "DracoType" && name.namePackage == ["draco"]
      loc rootRestored Boolean DracoAspect.parents(aspect).filterNot(root).isEmpty
      loc parents [Text] aspect.derivation.flatMap(\parent -> guard(parent.has("name")).ifThenElse(TypeName.read(parent).fold([], \name -> guard(rootRestored && root(name)).ifThenElse([], [reference(name)])), [typed(parent)]))
      loc formalText (TypeParameter -> Text) \p -> FormalOf(p).value
      loc name Text guard(definition.typeName.name.isEmpty).ifThenElse("", definition.typeName.name ++ guard(aspect.typeParameters.isEmpty).ifThenElse("", "(" ++ join(", ", aspect.typeParameters.map(formalText)) ++ ")"))
      loc extensible Text guard(aspect.extensible.name.isEmpty).ifThenElse("", join(" ", aspect.extensible.namePackage ++ [appliedName(aspect.extensible)]))
      loc factoryType Dracon guard(aspect.typeParameters.isEmpty).ifThenElse(Dracon.string(definition.typeName.name), Dracon.record([("()", Dracon.array([Dracon.string(definition.typeName.name)] ++ aspect.typeParameters.map(\p -> Dracon.string(p.name))))]))
      loc factoryPresent Boolean slot(aspect.factory.valueType).nonEmpty
      loc factoryResult Text guard(factoryPresent).ifThenElse(guard(slot(aspect.factory.valueType) == slot(factoryType)).ifThenElse("", slot(aspect.factory.valueType)), "")
      loc rendered DracoAspectText DracoAspectText(name, parents, aspect.modules.map(reference), extensible, aspect.elements.flatMap(\element -> elementText(element, 2)), factoryPresent, factoryResult, aspect.factory.parameters.flatMap(\element -> elementText(element, 3)), aspect.factory.body.flatMap(\element -> elementText(element, 3)), aspect.globalElements.flatMap(\element -> elementText(element, 2)))
      fix value Text rendered.value
uses [
  draco DracoAspect
  draco TypeDefinition
  draco TypeElement
  draco TypeName
  draco TypeParameter
  draco drake Text
  draco draketarget DracoAspectText
  draco format dracon Dracon
]
domain draco gendrake GenDrake
