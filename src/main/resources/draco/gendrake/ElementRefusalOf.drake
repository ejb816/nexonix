type ElementRefusalOf
  elements
    fix problems [Problem]
  factory
    parameters
      par element TypeElement
      par subject TypeName
    body
      loc element TypeElement _element
      loc subject TypeName _subject
      loc kind Text element.typeDefinition.typeName.name
      loc reason Text "Drake.emit: no drake keyword for element '" ++ element.name ++ "' (" ++ kind ++ ")"
      loc unkeyed [Problem] guard(Keyword.table.contains(kind)).ifThenElse([], [Problem(subject, reason)])
      loc informal (TypeElement -> [Text]) \member -> FormalsRefusalOf(member).reasons
      loc malformed [Problem] informal(element).map(\cause -> Problem(subject, cause))
      loc spelled (Dracon -> Text) \node -> ExpressionOf(node).value
      loc branch Boolean kind == "Case"
      loc block Boolean kind == "Dynamic" && (element.parameters.nonEmpty || element.body.nonEmpty)
      loc result Text " carries a value outside its body — the result is the body element named `value`"
      loc opener Text guard(branch).ifThenElse("Drake.emit: case-branch", "Drake.emit: block dyn '" ++ element.name ++ "'")
      loc refused (Dracon -> [Text]) \node -> ValueRefusalOf(node).reasons
      loc unrenderable [Problem] refused(element.value).map(\cause -> Problem(subject, cause))
      loc misplaced [Problem] guard((branch || block) && unrenderable.isEmpty && spelled(element.value) != "").ifThenElse([Problem(subject, opener ++ result)], [])
      loc nested (TypeElement -> [Problem]) \member -> ElementRefusalOf(member, subject).problems
      fix problems [Problem] unkeyed ++ malformed ++ unrenderable ++ misplaced ++ element.parameters.flatMap(nested) ++ element.body.flatMap(nested)
uses [
  draco FormalsRefusalOf
  draco Problem
  draco TypeElement
  draco TypeName
  draco drake Text
  draco draketarget Keyword
  draco format dracon Dracon
]
domain draco gendrake GenDrake
