type Primes
  elements
    fix knowledge org.evrete.api.Knowledge Rule.knowledgeService.newKnowledge("Primes")
  globals
    dyn filter [Int] [
      parameters
        par naturals [Int]
      body
        loc p Int naturals.head
        fix value [Int] cons(p, filter(naturals.tail.filter(_ % p != 0)))
    ]
    dyn naturals [Int] [
      parameters
        par start Int 0
        par step Int 1
      body
        fix value [Int] progression(start, step)
    ]
    dyn composites [Int] [
      parameters
        par primes [Int]
      body
        fix value [Int] naturals(2).filterNot(primes.contains(_)).take(primes.last - 1)
    ]
    dyn primesFromComposites [Int] [
      parameters
        par composites [Int]
      body
        fix value [Int] naturals(2).filterNot(composites.contains(_)).take(composites.last - composites.length)
    ]
    dyn nPrimes [Int] [
      parameters
        par n Int
      body
        fix value [Int] filter(naturals(2)).take(n)
    ]
domain draco primes Primes
  types [
    Accumulator
    Numbers
    AddNaturalSequence
    PrimesFromNaturalSequence
    RemoveCompositeNumbers
  ]
