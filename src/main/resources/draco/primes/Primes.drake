type Primes
  elements
    fix knowledge org.evrete.api.Knowledge Rule.knowledgeService.newKnowledge parameters par "Primes"
  globals
    dyn filter LazyList(Int) [
      parameters
        par naturals LazyList(Int)
      body
        loc p Int naturals.head
        fix value LazyList(Int) p #:: filter(naturals.tail.filter(_ % p != 0))
    ]
    dyn naturals LazyList(Int) [
      parameters
        par start Int 0
        par step Int 1
      body
        fix value LazyList(Int) LazyList.from(start, step)
    ]
    dyn composites [Int] [
      parameters
        par primes [Int]
      body
        fix value [Int] naturals(2).filterNot(primes.contains(_)).take(primes.last - 1)
    ]
    dyn primesFromComposites [Int] [
      parameters
        par composites [Int]
      body
        fix value [Int] naturals(2).filterNot(composites.contains(_)).take(composites.last - composites.length)
    ]
    dyn nPrimes [Int] [
      parameters
        par n Int
      body
        fix value [Int] filter(naturals(2)).take(n)
    ]
domain draco primes Primes
  types [
    Accumulator
    Numbers
    AddNaturalSequence
    PrimesFromNaturalSequence
    RemoveCompositeNumbers
  ]
