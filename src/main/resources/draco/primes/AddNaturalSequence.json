{
  "typeName": {
    "name": "AddNaturalSequence",
    "namePackage": [
      "draco",
      "primes"
    ]
  },
  "ruleAspect": {
    "pattern": {
      "kind": "Pattern",
      "variables": [
        {
          "kind": "Variable",
          "name": "accumulator",
          "valueType": "Accumulator"
        },
        {
          "kind": "Variable",
          "name": "i",
          "valueType": "Integer"
        }
      ]
    },
    "action": {
      "kind": "Action",
      "body": [
        {
          "kind": "Monadic",
          "value": "accumulator.primeSet.addOne(i)"
        },
        {
          "kind": "Monadic",
          "value": "accumulator.naturalSet.addOne(i)"
        },
        {
          "kind": "Fixed",
          "name": "text",
          "valueType": "String",
          "value": "s\"Added $i to primeSet and naturalSet.\""
        },
        {
          "kind": "Monadic",
          "value": "accumulator.intervalTextSet.addOne((System.nanoTime(), text))"
        }
      ]
    }
  },
  "domainAspect": {
    "typeName": {
      "name": "Primes",
      "namePackage": [
        "draco",
        "primes"
      ]
    }
  }
}
