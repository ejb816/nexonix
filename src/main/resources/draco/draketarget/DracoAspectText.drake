type DracoAspectText from Surface
  factory
    parameters
      par name Text
      par parents [Text] []
      par modules [Text] []
      par extensible Text ""
      par elements [Text] []
      par factoryPresent Boolean false
      par factoryResult Text ""
      par factoryParameters [Text] []
      par factoryBody [Text] []
      par globals [Text] []
    body
      loc header [Text] guard(_name.isEmpty).ifThenElse([], ["type " ++ _name ++ guard(_parents.isEmpty).ifThenElse("", " from " ++ join(" ", _parents))])
      loc moduleLines [Text] guard(_modules.isEmpty).ifThenElse([], ["  modules ["] ++ _modules.map(\member -> "    " ++ member) ++ ["  ]"])
      loc extensibleLines [Text] guard(_extensible.isEmpty).ifThenElse([], ["  extensible " ++ _extensible])
      loc elementLines [Text] guard(_elements.isEmpty).ifThenElse([], ["  elements"] ++ _elements)
      loc parameterLines [Text] guard(_factoryParameters.isEmpty).ifThenElse([], ["    parameters"] ++ _factoryParameters)
      loc bodyLines [Text] guard(_factoryBody.isEmpty).ifThenElse([], ["    body"] ++ _factoryBody)
      loc factoryLines [Text] guard(_factoryPresent).ifThenElse(["  factory" ++ guard(_factoryResult.isEmpty).ifThenElse("", " " ++ _factoryResult)] ++ parameterLines ++ bodyLines, [])
      loc globalLines [Text] guard(_globals.isEmpty).ifThenElse([], ["  globals"] ++ _globals)
      fix value Text join("\n", header ++ moduleLines ++ extensibleLines ++ elementLines ++ factoryLines ++ globalLines)
uses [
  draco drake Text
]
domain draco draketarget DrakeTarget
