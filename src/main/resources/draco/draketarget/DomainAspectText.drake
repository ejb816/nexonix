type DomainAspectText from Surface
  factory
    parameters
      par domainReference Text
      par parentReference Text ""
      par sourceReference Text ""
      par targetReference Text ""
      par members [Text] []
      par nameless Boolean false
    body
      loc parentLines [Text] guard(_parentReference.isEmpty).ifThenElse([], ["  super " ++ _parentReference])
      loc sourceLines [Text] guard(_sourceReference.isEmpty).ifThenElse([], ["  source " ++ _sourceReference])
      loc targetLines [Text] guard(_targetReference.isEmpty).ifThenElse([], ["  target " ++ _targetReference])
      loc memberLines [Text] guard(_members.isEmpty).ifThenElse([], ["  types ["] ++ _members.map(\member -> "    " ++ member) ++ ["  ]"])
      fix value Text guard(_nameless).ifThenElse("domain", guard(_domainReference.isEmpty).ifThenElse("", join("\n", ["domain " ++ _domainReference] ++ parentLines ++ sourceLines ++ targetLines ++ memberLines)))
uses [
  draco drake Text
]
domain draco draketarget DrakeTarget
