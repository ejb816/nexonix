type Present(T) from Presence(T)
  elements
    fix value T
    dyn fold(R) R [
      parameters
        par absent R
        par present (T -> R)
      body
        fix value R present(value)
    ]
    dyn ifThenElse(R) R [
      parameters
        par thenBranch R
        par elseBranch R
      body
        fix value R thenBranch
    ]
  factory
    parameters
      par value T
    body
      fix value T _value
domain draco drake Drake
