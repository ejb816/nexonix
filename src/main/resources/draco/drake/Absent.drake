type Absent(T) from Presence(T)
  elements
    dyn fold(R) R [
      parameters
        par absent R
        par present (T -> R)
      body
        fix value R absent
    ]
    dyn ifThenElse(R) R [
      parameters
        par thenBranch R
        par elseBranch R
      body
        fix value R elseBranch
    ]
  factory
domain draco drake Drake
