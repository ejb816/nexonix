type DomainOntology from Dictionary(DomainType, TypeDictionary)
  elements
    dyn defines Boolean [
      parameters
        par typeName TypeName
      body
        fix value Boolean kvMap.exists(\entry -> entry._1.typeDefinition.typeName.namePath == typeName.namePath || entry._2.elementTypes.exists(\td -> td.typeName.namePath == typeName.namePath))
    ]
  factory
    parameters
      par domains [DomainType] []
    body
      fix kvMap {DomainType, TypeDictionary} _domains.map(\domain -> (domain, domain.typeDictionary)).toMap
domain draco Draco
