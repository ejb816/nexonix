type DomainOntology from Dictionary(DomainType, TypeDictionary)
  elements
    fix derivations [Derivation]
    dyn owns Boolean [
      parameters
        par domain DomainType
        par typeName TypeName
      body
        fix value Boolean domain.typeDefinition.typeName.namePath == typeName.namePath || domain.typeDictionary.elementTypes.exists(\td -> td.typeName.namePath == typeName.namePath)
    ]
    dyn defines Boolean [
      parameters
        par typeName TypeName
      body
        fix value Boolean kvMap.keys.exists(\domain -> owns(domain, typeName))
    ]
    dyn dependencies [DomainType] [
      parameters
        par domain DomainType
      body
        fix value [DomainType] kvMap.keys.filter(\other -> other.typeDefinition.typeName != domain.typeDefinition.typeName && derivations.exists(\edge -> owns(domain, edge.child) && owns(other, edge.parent))).toSeq
    ]
    dyn including DomainOntology [
      parameters
        par domain DomainType
      body
        fix value DomainOntology DomainOntology(kvMap.keys.filter(\other -> other.typeDefinition.typeName.namePath != domain.typeDefinition.typeName.namePath).toSeq ++ [domain])
    ]
    dyn excluding DomainOntology [
      parameters
        par typeName TypeName
      body
        fix value DomainOntology DomainOntology(kvMap.keys.filter(\other -> other.typeDefinition.typeName.namePath != typeName.namePath).toSeq)
    ]
    dyn holds Boolean [
      parameters
        par typeName TypeName
      body
        fix value Boolean kvMap.keys.exists(\domain -> domain.typeDefinition.typeName.namePath == typeName.namePath)
    ]
    dyn holding draco.drake.Presence(DomainType) [
      parameters
        par typeName TypeName
      body
        fix value draco.drake.Presence(DomainType) presence(kvMap.keys.find(\domain -> domain.typeDefinition.typeName.namePath == typeName.namePath))
    ]
  factory
    parameters
      par domains [DomainType] []
    body
      fix kvMap {DomainType, TypeDictionary} _domains.map(\domain -> (domain, domain.typeDictionary)).toMap
      fix derivations [Derivation] _domains.flatMap(\domain -> domain.typeDictionary.elementTypes.prepended(domain.typeDefinition).flatMap(\td -> DracoAspect.parents(td.dracoAspect).map(\parent -> Derivation(td.typeName, parent))))
domain draco Draco
