type TypeElement from Primal(draco.format.dracon.Dracon)
  modules [
    BodyElement
  ]
  elements
    fix name String ""
    fix valueType draco.format.dracon.Dracon draco.format.dracon.Dracon.Null
    fix parameters [Parameter] []
    fix body [BodyElement] []
    fix value draco.format.dracon.Dracon draco.format.dracon.Dracon.Null
    fix now Boolean false
domain draco Draco
codec
  payload [valueType, value]
