type TypeElement from Primal(Dracon)
  modules [
    BodyElement
  ]
  elements
    fix name String ""
    fix valueType Dracon Dracon.Null
    fix parameters [Parameter] []
    fix body [BodyElement] []
    fix value Dracon Dracon.Null
    fix now Boolean false
domain draco Draco
codec
  payload [valueType, value]
