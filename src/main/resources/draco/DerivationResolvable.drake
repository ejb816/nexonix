type DerivationResolvable
domain draco Draco
rule
  pattern
    variables
      var m TypeDefinition
    conditions
      con draco.DracoAspect.parents(m.dracoAspect).exists(\anc -> anc.namePackage.headOption.contains("draco") && draco.TypeLoader.isStub(anc))
  action
    mon ctx.insert(Problem(m.typeName, s"member ${m.typeName.name} derives from a draco type that does not resolve to a definition"))
