type DerivationResolvable
domain draco Draco
rule
  pattern
    variables
      var m TypeDefinition
      var o DomainOntology
    conditions
      con o.derivations.exists(\edge -> edge.child == m.typeName && !o.defines(edge.parent))
  action
    mon ctx.insert(Problem(m.typeName, s"member ${m.typeName.name} derives from a type the ontology does not define"))
