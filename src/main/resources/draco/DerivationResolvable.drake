type DerivationResolvable
domain draco Draco
rule
  pattern
    variables
      var m TypeDefinition
    conditions
      con m.dracoAspect.derivation.exists(anc => anc.namePackage.headOption.contains("draco") && { val a = draco.TypeLoader.loadType(anc); draco.DracoAspect.isEmpty(a.dracoAspect) && draco.DomainAspect.isEmpty(a.domainAspect) && draco.RuleAspect.isEmpty(a.ruleAspect) && draco.ActorAspect.isEmpty(a.actorAspect) })
  action
    mon ctx.insert(Problem(m.typeName, s"member ${m.typeName.name} derives from a draco type that does not resolve to a definition"))
