{
  "typeName": {
    "name": "DerivationResolvable",
    "namePackage": [
      "draco"
    ]
  },
  "domainAspect": {
    "typeName": {
      "name": "Draco",
      "namePackage": [
        "draco"
      ]
    }
  },
  "ruleAspect": {
    "pattern": {
      "kind": "Pattern",
      "variables": [
        {
          "kind": "Variable",
          "name": "m",
          "valueType": "TypeDefinition"
        },
        {
          "kind": "Variable",
          "name": "o",
          "valueType": "DomainOntology"
        }
      ],
      "conditions": [
        {
          "kind": "Condition",
          "value": {
            "()": [
              {
                ".": [
                  {
                    "()": [
                      "draco.DracoAspect.parents",
                      "m.dracoAspect"
                    ]
                  },
                  "exists"
                ]
              },
              {
                "\\": [
                  "anc",
                  {
                    "()": [
                      "!o.defines",
                      "anc"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "action": {
      "kind": "Action",
      "body": [
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "ctx.insert",
              {
                "()": [
                  "Problem",
                  "m.typeName",
                  "s\"member ${m.typeName.name} derives from a type the ontology does not define\""
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
