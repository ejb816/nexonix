{
  "typeName": {
    "name": "DerivationResolvable",
    "namePackage": [
      "draco"
    ]
  },
  "domainAspect": {
    "typeName": {
      "name": "Draco",
      "namePackage": [
        "draco"
      ]
    }
  },
  "ruleAspect": {
    "pattern": {
      "kind": "Pattern",
      "variables": [
        {
          "kind": "Variable",
          "name": "m",
          "valueType": "TypeDefinition"
        }
      ],
      "conditions": [
        {
          "kind": "Condition",
          "value": {
            "()": [
              {
                ".": [
                  {
                    "()": [
                      "draco.DracoAspect.parents",
                      "m.dracoAspect"
                    ]
                  },
                  "exists"
                ]
              },
              {
                "\\": [
                  "anc",
                  {
                    "&&": [
                      {
                        "()": [
                          "anc.namePackage.headOption.contains",
                          "\"draco\""
                        ]
                      },
                      {
                        "()": [
                          "draco.TypeLoader.isStub",
                          "anc"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "action": {
      "kind": "Action",
      "body": [
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "ctx.insert",
              {
                "()": [
                  "Problem",
                  "m.typeName",
                  "s\"member ${m.typeName.name} derives from a draco type that does not resolve to a definition\""
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
