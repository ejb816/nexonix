{
  "typeName": {
    "name": "Completeness",
    "namePackage": [
      "draco"
    ]
  },
  "domainAspect": {
    "typeName": {
      "name": "Draco",
      "namePackage": [
        "draco"
      ]
    }
  },
  "ruleAspect": {
    "pattern": {
      "kind": "Pattern",
      "variables": [
        {
          "kind": "Variable",
          "name": "td",
          "valueType": "TypeDefinition"
        }
      ],
      "conditions": [
        {
          "kind": "Condition",
          "value": {
            "()": [
              "DracoAspect.isEmpty",
              "td.dracoAspect"
            ]
          }
        },
        {
          "kind": "Condition",
          "value": {
            "()": [
              "DomainAspect.isEmpty",
              "td.domainAspect"
            ]
          }
        },
        {
          "kind": "Condition",
          "value": {
            "()": [
              "td.ruleAspect.fold",
              "true",
              {
                "\\": [
                  "aspect",
                  "false"
                ]
              }
            ]
          }
        },
        {
          "kind": "Condition",
          "value": {
            "()": [
              "td.actorAspect.fold",
              "true",
              {
                "\\": [
                  "aspect",
                  "false"
                ]
              }
            ]
          }
        }
      ]
    },
    "action": {
      "kind": "Action",
      "body": [
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "ctx.insert",
              {
                "()": [
                  "Problem",
                  "td.typeName",
                  "s\"member ${td.typeName.name} is declared but unauthored (no JSON on disk)\""
                ]
              }
            ]
          }
        }
      ]
    }
  }
}