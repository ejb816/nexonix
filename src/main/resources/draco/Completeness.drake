type Completeness
domain draco Draco
rule
  pattern
    variables
      var td TypeDefinition
    conditions
      con draco.DracoAspect.isEmpty parameters par td.dracoAspect
      con draco.DomainAspect.isEmpty parameters par td.domainAspect
      con draco.RuleAspect.isEmpty parameters par td.ruleAspect
      con draco.ActorAspect.isEmpty parameters par td.actorAspect
  action
    mon ctx.insert(Problem(td.typeName, s"member ${td.typeName.name} is declared but unauthored (no JSON on disk)"))
