type Dictionary(K, V) from {K, V}
  elements
    fix kvMap {K, V}
    dyn removed {K, V} [
      parameters
        now par key K
      body
        fix value {K, V} kvMap.removed(key)
    ]
    dyn updated(V1 >: V) {K, V1} [
      parameters
        now par key K
        now par value V1
      body
        fix value {K, V1} kvMap.updated(key, value)
    ]
    dyn get Option(V) [
      parameters
        now par key K
      body
        fix value Option(V) kvMap.get(key)
    ]
    dyn iterator Iterator((K, V)) kvMap.iterator
domain draco Draco
