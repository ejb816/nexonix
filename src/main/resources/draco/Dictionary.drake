type Dictionary(K, V) from Map(K, V) DracoType
  elements
    fix kvMap {K, V}
    dyn removed {K, V} [
      parameters
        par key K
      = kvMap.removed(key)
    ]
    dyn updated(V1 >: V) {K, V1} [
      parameters
        par key K
        par value V1
      = kvMap.updated(key, value)
    ]
    dyn get Option(V) [
      parameters
        par key K
      = kvMap.get(key)
    ]
    dyn iterator Iterator((K, V)) kvMap.iterator
domain draco Draco
