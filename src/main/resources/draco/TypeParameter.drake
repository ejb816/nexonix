type TypeParameter
  elements
    fix name Text
    fix upperBound Dracon
    fix lowerBound Dracon
  factory
    parameters
      par name Text
      par upperBound Dracon Dracon.Null
      par lowerBound Dracon Dracon.Null
uses [
  draco drake Text
  draco format dracon Dracon
]
domain draco Draco
codec
  payload [upperBound, lowerBound]
