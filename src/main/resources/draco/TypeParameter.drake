type TypeParameter
  elements
    fix name draco.drake.Text
    fix upperBound draco.format.dracon.Dracon
    fix lowerBound draco.format.dracon.Dracon
  factory
    parameters
      par name draco.drake.Text
      par upperBound draco.format.dracon.Dracon draco.format.dracon.Dracon.Null
      par lowerBound draco.format.dracon.Dracon draco.format.dracon.Dracon.Null
domain draco Draco
codec
  payload [upperBound, lowerBound]
