type Value from draco format Value(Dracon)
  elements
    dyn decode(T) Presence(T) [
      parameters
        par source Dracon
        par decoder draco.format.dracon.Decoder(T)
      body
        fix value Presence(T) value(source).fold(Absent(), \selected -> decoder.decode(selected))
    ]
  factory
    parameters
      par name Text
      par pathElements [Text]
    body
      fix name Text _name
      fix pathElements [Text] _pathElements
      dyn value Presence(Dracon) [
        parameters
          par source Dracon
        body
          fix value Presence(Dracon) source.select(pathElements)
      ]
uses [
  draco drake Absent
  draco drake Presence
  draco drake Text
]
domain draco format dracon Dracon
