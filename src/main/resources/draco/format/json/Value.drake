type Value from draco format Value(JSON)
  factory
    parameters
      par name String
      par pathElements [String]
    body
      fix name String _name
      fix pathElements [String] _pathElements
      dyn value(T: Decoder) T [
        parameters
          par _source JSON
        body
          loc pathValue Json pathElements.foldLeft(Option(_source.json))(\e a -> e.flatMap(\j -> guard(j.isArray).ifThenElse(j.hcursor.downN(a.toInt).focus, j.hcursor.downField(a).focus))).orNull
          fix value T guard(pathValue != null).ifThenElse(pathValue.as[T].getOrElse(null.asInstanceOf[T]), null.asInstanceOf[T])
      ]
domain draco format json JSON
