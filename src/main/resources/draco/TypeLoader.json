{
  "typeName": {
    "name": "TypeLoader",
    "namePackage": [
      "draco"
    ]
  },
  "dracoAspect": {
    "globalElements": [
      {
        "kind": "Dynamic",
        "name": "readDefinition",
        "valueType": {
          "()": [
            "draco.drake.Presence",
            "TypeDefinition"
          ]
        },
        "parameters": [
          {
            "kind": "Parameter",
            "name": "url",
            "valueType": "URL",
            "now": true
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": {
              "()": [
                "draco.drake.Presence",
                "TypeDefinition"
              ]
            },
            "value": {
              "()": [
                "presence",
                "Option(url).flatMap { u => val source = scala.io.Source.fromURL(u); try io.circe.parser.parse(source.mkString).flatMap(_.as[TypeDefinition]).toOption finally source.close() }"
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "loadFromResource",
        "valueType": {
          "()": [
            "draco.drake.Presence",
            "TypeDefinition"
          ]
        },
        "parameters": [
          {
            "kind": "Parameter",
            "name": "resourcePath",
            "valueType": "String"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": {
              "()": [
                "draco.drake.Presence",
                "TypeDefinition"
              ]
            },
            "value": {
              "()": [
                {
                  ".": [
                    {
                      "()": [
                        "draco.generator.carrier.DefinitionPath.default.source",
                        "resourcePath"
                      ]
                    },
                    "fold"
                  ]
                },
                {
                  "()": [
                    "draco.drake.Absent"
                  ]
                },
                "readDefinition"
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "tryLoad",
        "valueType": {
          "()": [
            "draco.drake.Presence",
            "TypeDefinition"
          ]
        },
        "parameters": [
          {
            "kind": "Parameter",
            "name": "typeName",
            "valueType": "TypeName"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": {
              "()": [
                "draco.drake.Presence",
                "TypeDefinition"
              ]
            },
            "value": {
              "()": [
                "loadFromResource",
                "typeName.resourcePath"
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "rooted",
        "valueType": "TypeDefinition",
        "parameters": [
          {
            "kind": "Parameter",
            "name": "td",
            "valueType": "TypeDefinition",
            "now": true
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": "TypeDefinition",
            "value": {
              "()": [
                {
                  ".": [
                    {
                      "()": [
                        "guard",
                        "td.dracoAspect.derivation.exists(_.namePackage.nonEmpty) || (td.typeName.name == \"DracoType\" && td.typeName.namePackage == Seq(\"draco\"))"
                      ]
                    },
                    "ifThenElse"
                  ]
                },
                "td",
                {
                  "()": [
                    "TypeDefinition",
                    "_typeName = td.typeName",
                    "_dracoAspect = DracoAspect(_superDomain = td.dracoAspect.superDomain, _modules = td.dracoAspect.modules, _extensible = td.dracoAspect.extensible, _derivation = td.dracoAspect.derivation :+ TypeName(\"DracoType\", _namePackage = Seq(\"draco\")), _elements = td.dracoAspect.elements, _factory = td.dracoAspect.factory, _globalElements = td.dracoAspect.globalElements)",
                    "_domainAspect = td.domainAspect",
                    "_ruleAspect = td.ruleAspect",
                    "_actorAspect = td.actorAspect",
                    "_codecAspect = td.codecAspect"
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "kind": "Dynamic",
        "name": "loadType",
        "valueType": "TypeDefinition",
        "parameters": [
          {
            "kind": "Parameter",
            "name": "typeName",
            "valueType": "TypeName"
          }
        ],
        "body": [
          {
            "kind": "Fixed",
            "name": "value",
            "valueType": "TypeDefinition",
            "value": {
              "()": [
                {
                  ".": [
                    {
                      "()": [
                        "tryLoad",
                        "typeName"
                      ]
                    },
                    "fold"
                  ]
                },
                {
                  "()": [
                    "TypeDefinition",
                    "typeName"
                  ]
                },
                "rooted"
              ]
            }
          }
        ]
      }
    ]
  },
  "domainAspect": {
    "typeName": {
      "name": "Draco",
      "namePackage": [
        "draco"
      ]
    }
  }
}
