type DomainAspect
  elements
    fix typeName TypeName
    fix elementTypeNames [String]
    fix source TypeName
    fix target TypeName
  factory
    parameters
      par typeName TypeName TypeName.Null
      par elementTypeNames [String] []
      par source TypeName TypeName.Null
      par target TypeName TypeName.Null
  globals
    fix isEmpty (DomainAspect -> Boolean) da => da.typeName.name.isEmpty && da.elementTypeNames.isEmpty && da.source.name.isEmpty && da.target.name.isEmpty
domain draco Draco
