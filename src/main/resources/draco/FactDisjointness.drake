type FactDisjointness
domain draco Draco
rule
  pattern
    variables
      var d DomainType
      var o DomainOntology
    conditions
      con o.relatedFactTypes(d).nonEmpty
  action
    fix pairs [String] o.relatedFactTypes(d).map(\pair -> pair._1.namePath ++ " derives " ++ pair._2.namePath)
    mon ctx.insert(Problem(d.typeDefinition.typeName, s"rules of ${d.typeDefinition.typeName.namePath} declare fact types related by derivation: ${pairs.mkString(", ")}"))
