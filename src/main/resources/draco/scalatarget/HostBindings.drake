type HostBindings
  globals
    fix primitives [(Text, TypeName)] [("Any", TypeName("Any")), ("Boolean", TypeName("Boolean")), ("Double", TypeName("Double")), ("Int", TypeName("Int")), ("Long", TypeName("Long")), ("Product", TypeName("Product")), ("String", TypeName("String")), ("Integer", TypeName("Integer")), ("System", TypeName("System")), ("Enumeration", TypeName("Enumeration"))]
    fix collections [(Text, TypeName)] [("Array", TypeName("Array")), ("Iterator", TypeName("Iterator")), ("Map", TypeName("Map")), ("Option", TypeName("Option")), ("Seq", TypeName("Seq")), ("Some", TypeName("Some")), ("ArrayBuffer", TypeName("ArrayBuffer", ["scala", "collection", "mutable"]))]
    fix seams [(Text, TypeName)] [("Json", TypeName("Json", ["io", "circe"])), ("io.circe.Encoder", TypeName("Encoder", ["io", "circe"])), ("io.circe.Decoder", TypeName("Decoder", ["io", "circe"])), ("URI", TypeName("URI", ["java", "net"])), ("URL", TypeName("URL", ["java", "net"])), ("File", TypeName("File", ["java", "io"])), ("Files", TypeName("Files", ["java", "nio", "file"])), ("Path", TypeName("Path", ["java", "nio", "file"])), ("Paths", TypeName("Paths", ["java", "nio", "file"])), ("StandardCharsets", TypeName("StandardCharsets", ["java", "nio", "charset"])), ("BufferedSource", TypeName("BufferedSource", ["scala", "io"])), ("scala.io.Source", TypeName("Source", ["scala", "io"])), ("Try", TypeName("Try", ["scala", "util"])), ("ActivationMode", TypeName("ActivationMode", ["org", "evrete", "api"])), ("org.evrete.api.Knowledge", TypeName("Knowledge", ["org", "evrete", "api"])), ("KnowledgeService", TypeName("KnowledgeService", ["org", "evrete"])), ("StatefulSession", TypeName("StatefulSession", ["org", "evrete", "api"])), ("ExtensibleBehavior", TypeName("ExtensibleBehavior", ["org", "apache", "pekko", "actor", "typed"]))]
    fix engine [(Text, TypeName)] [("DracoGenerator", TypeName("DracoGenerator", ["draco"])), ("draco.Drake", TypeName("Drake", ["draco"])), ("NameResolution", TypeName("NameResolution", ["draco"])), ("draco.Generated", TypeName("Generated", ["draco"]))]
    fix bindings [(Text, TypeName)] primitives ++ collections ++ seams ++ engine
    dyn vocabulary {Text, TypeName} bindings.toMap
uses [
  draco TypeName
  draco drake Text
]
domain draco scalatarget ScalaTarget
