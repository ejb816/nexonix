type HostBindings
  globals
    fix primitives [(draco.drake.Text, draco.TypeName)] [("Any", draco.TypeName("Any")), ("Boolean", draco.TypeName("Boolean")), ("Double", draco.TypeName("Double")), ("Int", draco.TypeName("Int")), ("Long", draco.TypeName("Long")), ("Product", draco.TypeName("Product")), ("String", draco.TypeName("String")), ("Integer", draco.TypeName("Integer")), ("System", draco.TypeName("System")), ("Enumeration", draco.TypeName("Enumeration"))]
    fix collections [(draco.drake.Text, draco.TypeName)] [("Array", draco.TypeName("Array")), ("Iterator", draco.TypeName("Iterator")), ("Map", draco.TypeName("Map")), ("Option", draco.TypeName("Option")), ("Seq", draco.TypeName("Seq")), ("Some", draco.TypeName("Some")), ("ArrayBuffer", draco.TypeName("ArrayBuffer", ["scala", "collection", "mutable"]))]
    fix seams [(draco.drake.Text, draco.TypeName)] [("Json", draco.TypeName("Json", ["io", "circe"])), ("io.circe.Encoder", draco.TypeName("Encoder", ["io", "circe"])), ("io.circe.Decoder", draco.TypeName("Decoder", ["io", "circe"])), ("URI", draco.TypeName("URI", ["java", "net"])), ("URL", draco.TypeName("URL", ["java", "net"])), ("File", draco.TypeName("File", ["java", "io"])), ("Files", draco.TypeName("Files", ["java", "nio", "file"])), ("Path", draco.TypeName("Path", ["java", "nio", "file"])), ("Paths", draco.TypeName("Paths", ["java", "nio", "file"])), ("StandardCharsets", draco.TypeName("StandardCharsets", ["java", "nio", "charset"])), ("BufferedSource", draco.TypeName("BufferedSource", ["scala", "io"])), ("scala.io.Source", draco.TypeName("Source", ["scala", "io"])), ("Try", draco.TypeName("Try", ["scala", "util"])), ("ActivationMode", draco.TypeName("ActivationMode", ["org", "evrete", "api"])), ("org.evrete.api.Knowledge", draco.TypeName("Knowledge", ["org", "evrete", "api"])), ("KnowledgeService", draco.TypeName("KnowledgeService", ["org", "evrete", "api"])), ("StatefulSession", draco.TypeName("StatefulSession", ["org", "evrete", "api"])), ("ExtensibleBehavior", draco.TypeName("ExtensibleBehavior", ["org", "apache", "pekko", "actor", "typed"]))]
    fix engine [(draco.drake.Text, draco.TypeName)] [("DracoGenerator", draco.TypeName("DracoGenerator", ["draco"])), ("draco.Drake", draco.TypeName("Drake", ["draco"])), ("NameResolution", draco.TypeName("NameResolution", ["draco"]))]
    fix bindings [(draco.drake.Text, draco.TypeName)] primitives ++ collections ++ seams ++ engine
    dyn vocabulary {draco.drake.Text, draco.TypeName} bindings.toMap
domain draco scalatarget ScalaTarget
