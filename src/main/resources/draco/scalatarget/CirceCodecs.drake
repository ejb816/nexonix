type CirceCodecs
  globals
    fix payloadEncoder draco.format.dracon.Encoder(draco.format.dracon.Dracon) draco.format.dracon.Encoder(\value -> value)
    fix payloadDecoder draco.format.dracon.Decoder(draco.format.dracon.Dracon) draco.format.dracon.Decoder(\value -> draco.drake.Present(value))
    fix encodePayload io.circe.Encoder(draco.format.dracon.Dracon) io.circe.Encoder.instance(value => payloadEncoder.encode(value).json)
    fix decodePayload io.circe.Decoder(draco.format.dracon.Dracon) io.circe.Decoder.instance(cursor => payloadDecoder.decode(draco.format.dracon.Dracon(cursor.value)).fold(Left(io.circe.DecodingFailure("Absent payload", cursor.history)), value => Right(value)))
    dyn encoder(T) draco.format.dracon.Encoder(T) [
      parameters
        par host io.circe.Encoder(T)
      body
        fix value draco.format.dracon.Encoder(T) draco.format.dracon.Encoder(\value -> draco.format.dracon.Dracon(host(value)))
    ]
    dyn decoder(T) draco.format.dracon.Decoder(T) [
      parameters
        par host io.circe.Decoder(T)
      body
        fix value draco.format.dracon.Decoder(T) draco.format.dracon.Decoder(\source -> presence(host.decodeJson(source.json).toOption))
    ]
domain draco scalatarget ScalaTarget
