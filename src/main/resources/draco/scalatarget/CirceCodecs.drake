type CirceCodecs
  globals
    fix payloadEncoder Encoder(Dracon) Encoder(\value -> value)
    fix payloadDecoder Decoder(Dracon) Decoder(\value -> Present(value))
    fix encodePayload io.circe.Encoder(Dracon) io.circe.Encoder.instance(value => payloadEncoder.encode(value).json)
    fix decodePayload io.circe.Decoder(Dracon) io.circe.Decoder.instance(cursor => payloadDecoder.decode(draco.format.dracon.Dracon(cursor.value)).fold(Left(io.circe.DecodingFailure("Absent payload", cursor.history)), value => Right(value)))
    dyn encoder(T) Encoder(T) [
      parameters
        par host io.circe.Encoder(T)
      body
        fix value Encoder(T) Encoder(\value -> Dracon(host(value)))
    ]
    dyn decoder(T) Decoder(T) [
      parameters
        par host io.circe.Decoder(T)
      body
        fix value Decoder(T) Decoder(\source -> presence(host.decodeJson(source.json).toOption))
    ]
domain draco scalatarget ScalaTarget
