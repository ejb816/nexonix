type DracoAspect
  elements
    fix superDomain TypeName
    fix modules [TypeName]
    fix extensible TypeName
    fix derivation [draco.format.dracon.Dracon]
    fix elements [TypeElement]
    fix factory Factory
    fix globalElements [BodyElement]
  factory
    parameters
      par superDomain TypeName TypeName.Null
      par modules [TypeName] []
      par extensible TypeName TypeName.Null
      par derivation [draco.format.dracon.Dracon] []
      par elements [TypeElement] []
      par factory Factory Factory.Null
      par globalElements [BodyElement] []
  globals
    fix isEmpty (DracoAspect -> Boolean) \da -> da.superDomain.name.isEmpty && da.modules.isEmpty && da.extensible.name.isEmpty && da.derivation.isEmpty && da.elements.isEmpty && da.factory.valueType.isNull && da.globalElements.isEmpty
    fix parents (DracoAspect -> [TypeName]) \da -> da.derivation.filter(\parent -> parent.has("name")).flatMap(\parent -> TypeName.read(parent).fold([], \name -> [name]))
    fix foreignParents (DracoAspect -> [draco.format.dracon.Dracon]) \da -> da.derivation.filterNot(\parent -> parent.has("name"))
domain draco Draco
codec
  payload [derivation]
