type SourceContent
  elements
    fix source BufferedSource
    fix sourceLines [String]
    fix sourceString String
  factory
    parameters
      par sourceRoot URI
      par logicalPath String
    body
      loc sourceURI URI _sourceRoot.resolve(URI.create(_logicalPath))
      fix source BufferedSource scala.io.Source.fromFile(sourceURI)
      fix sourceLines [String] bracket(source, \s -> s.close(), \s -> s.getLines().toSeq)
      fix sourceString String sourceLines.mkString("\n")
domain draco Draco
