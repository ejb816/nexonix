type Rule(T) from RuleType
  elements
    fix pattern (Knowledge -> ())
    fix action (RhsContext -> ())
  factory
    parameters
      par pattern (Knowledge -> ())
      par action (RhsContext -> ())
  globals
    fix knowledgeService KnowledgeService new KnowledgeService ()
uses [
  draco rete Knowledge
  draco rete RhsContext
]
domain draco Draco
