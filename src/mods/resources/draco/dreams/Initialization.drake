type Initialization
  elements
    fix domains [Create]
    fix initial DomainOntology
    fix responses [Response]+
    mut ontology DomainOntology
    fix note (Response -> ())
    fix keep (DomainOntology -> ())
    dyn owns Boolean [
      parameters
        par latent Latent
        par typeName TypeName
      body
        fix value Boolean latent.definition.typeName.namePath == typeName.namePath || latent.members.exists(\m -> m.typeName.namePath == typeName.namePath)
    ]
    dyn parents [TypeName] [
      parameters
        par latent Latent
      body
        fix value [TypeName] latent.members.prepended(latent.definition).flatMap(\td -> DracoAspect.parents(td.dracoAspect)).filter(\p -> !owns(latent, p))
    ]
    dyn ready Boolean [
      parameters
        par latent Latent
        par placed [Create]
      body
        fix value Boolean parents(latent).filter(\p -> domains.exists(\l -> owns(l, p))).forall(\p -> placed.exists(\l -> owns(l, p)))
    ]
    dyn order [Create] [
      parameters
        par placed [Create]
        par remaining [Create]
      body
        fix wave [Create] remaining.filter(\l -> ready(l, placed))
        fix rest [Create] remaining.filterNot(\l -> ready(l, placed))
        fix value [Create] guard(wave.isEmpty).ifThenElse(placed ++ remaining, order(placed ++ wave, rest))
    ]
    dyn ordered [Create] order([], domains)
    dyn editorType ActorType Editor.actorType(initial, note, keep)
    dyn run () [
      parameters
        par editor (Create -> ())
      body
        fix value () ordered.foreach(editor)
    ]
    dyn complete Boolean responses.size == domains.size
    dyn accepted Boolean complete && responses.forall(\r -> r.accepted)
  factory
    parameters
      par domains [Create] []
    body
      fix domains [Create] _domains
      fix initial DomainOntology DomainOntology()
      fix responses [Response]+ scala.collection.mutable.ArrayBuffer()
      mut ontology DomainOntology initial
      fix note (Response -> ()) \r -> add(responses, r)
      fix keep (DomainOntology -> ()) \o -> ontology = o
uses [
  draco ActorType
  draco DomainOntology
  draco DracoAspect
  draco TypeName
  draco dreams editor Editor
  draco dreams user Create
  draco dreams user Latent
  draco dreams user Response
]
domain draco dreams Dreams
