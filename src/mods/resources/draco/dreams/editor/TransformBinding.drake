type TransformBinding
  elements
    fix domain DomainType
    fix supers [DomainType]
    fix rules [(TypeDefinition, RuleType)]
    fix nameBindings [(Text, TypeName)]
    dyn domains [DomainType] supers.prepended(domain)
    dyn definitions [TypeDefinition] domains.flatMap(\d -> d.typeDictionary.elementTypes.prepended(d.typeDefinition))
    dyn matches Boolean [
      parameters
        par accepted DomainOntology
      body
        fix aspect DomainAspect domain.typeDefinition.domainAspect
        fix expected [io.circe.Json] definitions.filter(\td -> !draco.RuleAspect.isEmpty(td.ruleAspect)).map(\td -> TypeDefinition.encoder(td))
        fix actual [io.circe.Json] rules.map(\r -> TypeDefinition.encoder(r._1))
        fix value Boolean aspect.source.namePath == TypeDefinition.typeDefinition.typeName.namePath && aspect.target.name.nonEmpty && domains.map(\d -> d.typeDefinition.typeName.namePath).distinct.size == domains.size && domains.forall(\d -> accepted.holding(d.typeDefinition.typeName).fold(false, \held -> TypeDefinition.encoder(held.typeDefinition) == TypeDefinition.encoder(d.typeDefinition) && held.typeDictionary.elementTypes.map(\td -> TypeDefinition.encoder(td)).toSet == d.typeDictionary.elementTypes.map(\td -> TypeDefinition.encoder(td)).toSet)) && domains.forall(\d -> d.typeDefinition.dracoAspect.superDomain.name.isEmpty || domains.exists(\s -> s.typeDefinition.typeName.namePath == d.typeDefinition.dracoAspect.superDomain.namePath)) && actual.distinct.size == actual.size && actual.toSet == expected.toSet
    ]
    dyn generate draco.dreams.editor.Generated [
      parameters
        par subject TypeName
        par transform TypeName
        par definitions [TypeDefinition]
        par ontology DomainOntology
      body
        fix value draco.dreams.editor.Generated try { val emissions = run(definitions, ontology); draco.dreams.editor.Generated(subject, transform, emissions) } catch { case scala.util.control.NonFatal(error) => draco.dreams.editor.Generated(subject, transform, Seq.empty, Seq(draco.Problem(transform, "generation failed: " + error.getClass.getSimpleName + ": " + Option(error.getMessage).getOrElse("")))) }
    ]
    dyn run [Emission] [
      parameters
        par definitions [TypeDefinition]
        par ontology DomainOntology
      body
        mon require(nameBindings.map(_._1).distinct.size == nameBindings.size, "duplicate name binding")
        fix resolutionScope draco.NameResolution new draco.NameResolution(ontology, nameBindings.toMap)
        now fix resolved [TypeDefinition] definitions.map(resolutionScope.resolve)
        fix knowledge org.evrete.api.Knowledge Rule.knowledgeService.newKnowledge("Generate")
        mon rules.foreach(\r -> r._2.pattern(knowledge))
        fix received [Emission]+ scala.collection.mutable.ArrayBuffer()
        fix session org.evrete.api.StatefulSession knowledge.newStatefulSession()
        fix value [Emission] try { session.set("received", received); session.set("nameResolution", resolutionScope); session.insert(resolved.toSeq: _*); session.fire(); require(received.size == definitions.size, "transform did not emit once per definition"); received.toSeq } finally session.close()
    ]
  factory
    parameters
      par domain DomainType
      par supers [DomainType]
      par rules [(TypeDefinition, RuleType)]
      par nameBindings [(Text, TypeName)] []
uses [
  draco DomainAspect
  draco DomainOntology
  draco DomainType
  draco Rule
  draco RuleType
  draco TypeDefinition
  draco TypeName
  draco drake Text
  draco generator Emission
]
domain draco dreams editor Editor
