type Editor
  factory ActorType
    parameters
      par initial draco.DomainOntology
      par actual (draco.dreams.user.Response -> Unit)
      par ontology (draco.DomainOntology -> Unit)
domain draco dreams editor Editor
  types [
    Actual
  ]
actor
  messageType draco dreams user Request
  start
    fix rules org.evrete.api.Knowledge draco.Rule.knowledgeService.newKnowledge("Editor")
    mon draco.Completeness.ruleType.pattern(rules)
    mon draco.SelfDeclaration.ruleType.pattern(rules)
    mon draco.DerivationResolvable.ruleType.pattern(rules)
    mon draco.Uniqueness.ruleType.pattern(rules)
    mon draco.CollectProblems.ruleType.pattern(rules)
    mut accepted draco.DomainOntology initial
    fix accept (draco.DomainOntology -> Unit) \next -> accepted = next
  message
    case latent draco.dreams.user.Latent [
      fix candidate draco.DomainType draco.Domain(latent.definition, latent.members)
      fix provisional draco.DomainOntology accepted.including(candidate)
      fix definitions [draco.TypeDefinition] provisional.keys.toSeq.flatMap(\domain -> domain.typeDictionary.elementTypes.prepended(domain.typeDefinition))
      fix problems [draco.Problem]+ scala.collection.mutable.ArrayBuffer()
      fix session org.evrete.api.StatefulSession rules.newStatefulSession(org.evrete.api.ActivationMode.CONTINUOUS)
      mon session.set("problems", problems)
      mon session.insert(provisional.keys.toSeq: _*)
      mon session.insert(definitions.toSeq: _*)
      mon session.insert(Seq(provisional): _*)
      mon session.fire()
      mon session.close()
      mon guard(problems.isEmpty).ifThenElse(accept(provisional), accept(accepted))
      mon actual(Actual(latent.definition, latent.members, problems.toSeq))
      mon guard(problems.isEmpty).ifThenElse(ontology(accepted), ())
    ]
    case read draco.dreams.user.Read [
      fix owner draco.drake.Presence(draco.DomainType) presence(accepted.keys.find(\d -> d.typeDefinition.typeName.namePath == read.domain.namePath))
      mon actual(owner.fold(Actual(draco.TypeDefinition(read.domain), [], [draco.Problem(read.domain, s"domain ${read.domain.name} is not in the accepted ontology")]), \d -> Actual(d.typeDefinition, d.typeDictionary.elementTypes)))
    ]
