type Editor
  factory ActorType
    parameters
      par initial DomainOntology
      par actual (Response -> ())
      par ontology (DomainOntology -> ())
      par transforms [TransformBinding] []
uses [
  draco ActorType
  draco CollectProblems
  draco Completeness
  draco DerivationResolvable
  draco DomainOntology
  draco Problem
  draco Rule
  draco SelfDeclaration
  draco TypeDefinition
  draco Uniqueness
  draco dreams user Response
]
domain draco dreams editor Editor
  types [
    Accepted
    Actual
    CreateHeld
    DeleteUnheld
    Generated
    GenerateRequested
    TransformBinding
    ReadUnheld
    UpdateUnheld
  ]
actor
  messageType draco dreams user Request
  start
    fix rules org.evrete.api.Knowledge Rule.knowledgeService.newKnowledge("Editor")
    mon Completeness.ruleType.pattern(rules)
    mon SelfDeclaration.ruleType.pattern(rules)
    mon DerivationResolvable.ruleType.pattern(rules)
    mon Uniqueness.ruleType.pattern(rules)
    mon CollectProblems.ruleType.pattern(rules)
    mon CreateHeld.ruleType.pattern(rules)
    mon UpdateUnheld.ruleType.pattern(rules)
    mon ReadUnheld.ruleType.pattern(rules)
    mon DeleteUnheld.ruleType.pattern(rules)
    mon GenerateRequested.ruleType.pattern(rules)
    mut accepted DomainOntology initial
    fix accept (DomainOntology -> ()) \next -> accepted = next
  message
    now fix provisional DomainOntology msg.proposal(accepted)
    now fix subject TypeDefinition msg.subject(accepted)
    now fix contents [TypeDefinition] msg.contents(accepted)
    now fix changing Boolean provisional != accepted
    fix definitions [TypeDefinition] provisional.keys.toSeq.flatMap(\domain -> domain.typeDictionary.elementTypes.prepended(domain.typeDefinition))
    fix problems [Problem]+ scala.collection.mutable.ArrayBuffer()
    fix responses [[Problem] -> Response]+ scala.collection.mutable.ArrayBuffer()
    fix session org.evrete.api.StatefulSession rules.newStatefulSession(org.evrete.api.ActivationMode.CONTINUOUS)
    mon session.set("problems", problems)
    mon session.set("transforms", transforms)
    mon session.set("responses", responses)
    mon session.insert(Seq(msg): _*)
    mon session.insert(Seq(Accepted(accepted)): _*)
    mon session.insert(provisional.keys.toSeq: _*)
    mon session.insert(definitions.toSeq: _*)
    mon session.insert(Seq(provisional): _*)
    mon session.fire()
    mon session.close()
    mon guard(problems.isEmpty).ifThenElse(accept(provisional), accept(accepted))
    mon actual(responses.headOption.fold[draco.dreams.user.Response](Actual(subject, contents, problems.toSeq))(\respond -> respond(problems.toSeq)))
    mon guard(problems.isEmpty && changing).ifThenElse(ontology(accepted), ())
