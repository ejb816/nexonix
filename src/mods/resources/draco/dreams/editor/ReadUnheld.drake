type ReadUnheld
uses [
  draco Problem
  draco dreams user Read
]
domain draco dreams editor Editor
rule
  pattern
    variables
      var r Read
      var a Accepted
    conditions
      con !a.ontology.holds(r.domain)
  action
    mon ctx.insert(Problem(r.domain, s"domain ${r.domain.name} is not in the accepted ontology"))
