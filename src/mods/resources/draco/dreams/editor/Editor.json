{
  "typeName": {
    "name": "Editor",
    "namePackage": [
      "draco",
      "dreams",
      "editor"
    ]
  },
  "dracoAspect": {
    "factory": {
      "kind": "Factory",
      "valueType": "ActorType",
      "parameters": [
        {
          "kind": "Parameter",
          "name": "initial",
          "valueType": "draco.DomainOntology"
        },
        {
          "kind": "Parameter",
          "name": "actual",
          "valueType": {
            "->": [
              "draco.dreams.user.Response",
              "Unit"
            ]
          }
        },
        {
          "kind": "Parameter",
          "name": "ontology",
          "valueType": {
            "->": [
              "draco.DomainOntology",
              "Unit"
            ]
          }
        }
      ]
    }
  },
  "domainAspect": {
    "typeName": {
      "name": "Editor",
      "namePackage": [
        "draco",
        "dreams",
        "editor"
      ]
    },
    "elementTypeNames": [
      "Actual"
    ]
  },
  "actorAspect": {
    "message": {
      "kind": "Action",
      "body": [
        {
          "kind": "Case",
          "name": "latent",
          "valueType": "draco.dreams.user.Latent",
          "body": [
            {
              "kind": "Fixed",
              "name": "candidate",
              "valueType": "draco.DomainType",
              "value": {
                "()": [
                  "draco.Domain",
                  "latent.definition",
                  "latent.members"
                ]
              }
            },
            {
              "kind": "Fixed",
              "name": "provisional",
              "valueType": "draco.DomainOntology",
              "value": {
                "()": [
                  "accepted.including",
                  "candidate"
                ]
              }
            },
            {
              "kind": "Fixed",
              "name": "definitions",
              "valueType": {
                "[]": [
                  "draco.TypeDefinition"
                ]
              },
              "value": {
                "()": [
                  "provisional.keys.toSeq.flatMap",
                  {
                    "\\": [
                      "domain",
                      {
                        "()": [
                          "domain.typeDictionary.elementTypes.prepended",
                          "domain.typeDefinition"
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "kind": "Fixed",
              "name": "problems",
              "valueType": {
                "[]+": [
                  "draco.Problem"
                ]
              },
              "value": {
                "()": [
                  "scala.collection.mutable.ArrayBuffer"
                ]
              }
            },
            {
              "kind": "Fixed",
              "name": "session",
              "valueType": "org.evrete.api.StatefulSession",
              "value": {
                "()": [
                  "rules.newStatefulSession",
                  "org.evrete.api.ActivationMode.CONTINUOUS"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "session.set",
                  "\"problems\"",
                  "problems"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "session.insert",
                  "provisional.keys.toSeq: _*"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "session.insert",
                  "definitions.toSeq: _*"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "session.insert",
                  "Seq(provisional): _*"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "session.fire"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "session.close"
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  {
                    ".": [
                      {
                        "()": [
                          "guard",
                          "problems.isEmpty"
                        ]
                      },
                      "ifThenElse"
                    ]
                  },
                  {
                    "()": [
                      "accept",
                      "provisional"
                    ]
                  },
                  {
                    "()": [
                      "accept",
                      "accepted"
                    ]
                  }
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  "actual",
                  {
                    "()": [
                      "Actual",
                      "latent.definition",
                      "latent.members",
                      "problems.toSeq"
                    ]
                  }
                ]
              }
            },
            {
              "kind": "Monadic",
              "value": {
                "()": [
                  {
                    ".": [
                      {
                        "()": [
                          "guard",
                          "problems.isEmpty"
                        ]
                      },
                      "ifThenElse"
                    ]
                  },
                  {
                    "()": [
                      "ontology",
                      "accepted"
                    ]
                  },
                  "()"
                ]
              }
            }
          ]
        }
      ]
    },
    "messageType": {
      "name": "Request",
      "namePackage": [
        "draco",
        "dreams",
        "user"
      ]
    },
    "start": {
      "kind": "Action",
      "body": [
        {
          "kind": "Fixed",
          "name": "rules",
          "valueType": "org.evrete.api.Knowledge",
          "value": {
            "()": [
              "draco.Rule.knowledgeService.newKnowledge",
              "\"Editor\""
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "draco.Completeness.ruleType.pattern",
              "rules"
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "draco.SelfDeclaration.ruleType.pattern",
              "rules"
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "draco.DerivationResolvable.ruleType.pattern",
              "rules"
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "draco.Uniqueness.ruleType.pattern",
              "rules"
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "draco.CollectProblems.ruleType.pattern",
              "rules"
            ]
          }
        },
        {
          "kind": "Mutable",
          "name": "accepted",
          "valueType": "draco.DomainOntology",
          "value": "initial"
        },
        {
          "kind": "Fixed",
          "name": "accept",
          "valueType": {
            "->": [
              "draco.DomainOntology",
              "Unit"
            ]
          },
          "value": {
            "\\": [
              "next",
              "accepted = next"
            ]
          }
        }
      ]
    }
  }
}
