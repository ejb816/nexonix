type DeleteUnheld
uses [
  draco Problem
  draco dreams user Delete
]
domain draco dreams editor Editor
rule
  pattern
    variables
      var d Delete
      var a Accepted
    conditions
      con !a.ontology.holds(d.domain)
  action
    mon ctx.insert(Problem(d.domain, s"domain ${d.domain.name} is not in the accepted ontology"))
