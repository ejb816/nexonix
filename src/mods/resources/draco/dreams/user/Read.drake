type Read from Request
  elements
    fix domain TypeName
    dyn proposal DomainOntology [
      parameters
        par accepted DomainOntology
      body
        fix value DomainOntology accepted
    ]
    dyn subject TypeDefinition [
      parameters
        par accepted DomainOntology
      body
        fix value TypeDefinition accepted.holding(domain).fold(TypeDefinition(domain), \d -> d.typeDefinition)
    ]
    dyn contents [TypeDefinition] [
      parameters
        par accepted DomainOntology
      body
        fix value [TypeDefinition] accepted.holding(domain).fold([], \d -> d.typeDictionary.elementTypes)
    ]
  factory
    parameters
      par domain TypeName
uses [
  draco DomainOntology
  draco TypeDefinition
  draco TypeName
]
domain draco dreams user User
