type Create from Latent
  elements
    fix definition draco.TypeDefinition
    fix members [draco.TypeDefinition]
    dyn proposal draco.DomainOntology [
      parameters
        par accepted draco.DomainOntology
      body
        fix value draco.DomainOntology accepted.including(draco.Domain(definition, members))
    ]
    dyn subject draco.TypeDefinition [
      parameters
        par accepted draco.DomainOntology
      body
        fix value draco.TypeDefinition definition
    ]
    dyn contents [draco.TypeDefinition] [
      parameters
        par accepted draco.DomainOntology
      body
        fix value [draco.TypeDefinition] members
    ]
  factory
    parameters
      par definition draco.TypeDefinition
      par members [draco.TypeDefinition] []
domain draco dreams user User
