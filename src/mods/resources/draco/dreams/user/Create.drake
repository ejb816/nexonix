type Create from Latent
  elements
    fix definition TypeDefinition
    fix members [TypeDefinition]
    dyn proposal DomainOntology [
      parameters
        par accepted DomainOntology
      body
        fix value DomainOntology accepted.including(Domain(definition, members))
    ]
    dyn subject TypeDefinition [
      parameters
        par accepted DomainOntology
      body
        fix value TypeDefinition definition
    ]
    dyn contents [TypeDefinition] [
      parameters
        par accepted DomainOntology
      body
        fix value [TypeDefinition] members
    ]
  factory
    parameters
      par definition TypeDefinition
      par members [TypeDefinition] []
uses [
  draco Domain
  draco DomainOntology
  draco TypeDefinition
]
domain draco dreams user User
