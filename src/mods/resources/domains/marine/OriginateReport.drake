type OriginateReport
uses [
  draco format dracon Dracon
]
domain domains marine Marine
rule
  pattern
    variables
      var intent VoyageIntent
  action
    fix consumer (Dracon -> ()) ctx.getRuntime().get[draco.format.dracon.Dracon => Unit]("consumer")
    fix cursor io.circe.HCursor intent.json.hcursor
    fix vessel String cursor.get[String]("vessel").getOrElse("UNKNOWN")
    fix depthMetres Int cursor.get[Int]("depthMetres").getOrElse(0)
    fix depthFathoms Int depthMetres * 10000 / 18288
    fix payload io.circe.Json io.circe.Json.obj(("kind", io.circe.Json.fromString("FIX")), ("vessel", io.circe.Json.fromString(vessel)), ("depthFathoms", io.circe.Json.fromInt(depthFathoms)))
    fix report FixReport FixReport(payload)
    mon consumer(report)
