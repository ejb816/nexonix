type Consumer from draco Actor(World)
  factory ActorType
    parameters
      par provider (World -> ())
uses [
  domains aerial Position
  domains terrestrial Location
  draco ActorType
]
domain domains world World
actor
  messageType World
  message
    case position Position [
      now fix heightMetres Double position.altitudeFeet * 0.3048
      now fix observable Observable Observable.fromGeodetic(position.latitude, position.longitude, heightMetres)
      now fix coordinates (Double, Double, Double) Observable.toGeodetic(observable)
      now fix location Location Location(coordinates._1, coordinates._2, math.round(coordinates._3).toInt)
      mon provider(location)
    ]
