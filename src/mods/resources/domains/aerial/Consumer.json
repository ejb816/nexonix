{
  "typeName": {
    "name": "Consumer",
    "namePackage": [
      "domains",
      "aerial"
    ]
  },
  "domainAspect": {
    "typeName": {
      "name": "Aerial",
      "namePackage": [
        "domains",
        "aerial"
      ]
    }
  },
  "actorAspect": {
    "message": {
      "kind": "Action",
      "body": [
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "session.insert",
              "Seq(msg): _*"
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "session.fire"
            ]
          }
        }
      ]
    },
    "messageType": {
      "name": "JSON",
      "namePackage": [
        "draco",
        "format",
        "json"
      ]
    },
    "signal": {
      "kind": "Action",
      "body": [
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "consumed.foreach",
              {
                "\\": [
                  "(e: String)",
                  {
                    "()": [
                      "domains.aerial.AerialSink.record",
                      "e"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "session.close"
            ]
          }
        }
      ]
    },
    "start": {
      "kind": "Action",
      "body": [
        {
          "kind": "Fixed",
          "name": "session",
          "valueType": "org.evrete.api.StatefulSession",
          "value": {
            "()": [
              "knowledge.newStatefulSession"
            ]
          }
        },
        {
          "kind": "Fixed",
          "name": "consumed",
          "valueType": {
            "[]+": [
              "String"
            ]
          },
          "value": {
            "[]": []
          }
        },
        {
          "kind": "Monadic",
          "value": {
            "()": [
              "session.set",
              "\"consumed\"",
              "consumed"
            ]
          }
        }
      ]
    }
  }
}
