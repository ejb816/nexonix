type Input
  factory ActorType
    parameters
      par worldConsumer ActorRef(domains.world.World)
domain domains aerial Aerial
actor
  messageType draco format json JSON
  message
    fix cursor io.circe.HCursor msg.json.hcursor
    fix position domains.aerial.Position Position(latitude:cursor.get[Double]("latitude").getOrElse(0.0), longitude:cursor.get[Double]("longitude").getOrElse(0.0), altitudeFeet:cursor.get[Int]("altitudeFeet").getOrElse(0))
    mon worldConsumer ! position
