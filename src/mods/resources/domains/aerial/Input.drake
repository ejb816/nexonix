type Input
  factory ActorType
    parameters
      par worldConsumer (World -> ())
uses [
  domains world World
  draco ActorType
]
domain domains aerial Aerial
actor
  messageType draco format dracon Dracon
  message
    fix cursor io.circe.HCursor msg.json.hcursor
    fix position Position Position(latitude:cursor.get[Double]("latitude").getOrElse(0.0), longitude:cursor.get[Double]("longitude").getOrElse(0.0), altitudeFeet:cursor.get[Int]("altitudeFeet").getOrElse(0))
    mon worldConsumer(position)
