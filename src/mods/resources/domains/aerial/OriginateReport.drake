type OriginateReport
domain domains aerial Aerial
rule
  pattern
    variables
      var intent FlightIntent
  action
    fix consumer (draco.format.dracon.Dracon -> ()) ctx.getRuntime().get[draco.format.dracon.Dracon => Unit]("consumer")
    fix cursor io.circe.HCursor intent.json.hcursor
    fix callsign String cursor.get[String]("callsign").getOrElse("UNKNOWN")
    fix flightLevel Int cursor.get[Int]("flightLevel").getOrElse(0)
    fix payload io.circe.Json io.circe.Json.obj(("message", io.circe.Json.fromString("POSITION")), ("callsign", io.circe.Json.fromString(callsign)), ("altitudeFeet", io.circe.Json.fromInt(flightLevel * 100)))
    fix report PositionReport PositionReport(payload)
    mon consumer(report)
