type Creator
  factory ActorType
    parameters
      par consumer (Dracon -> ())
uses [
  draco ActorType
  draco format dracon Dracon
  draco rete StatefulSession
]
domain domains terrestrial Terrestrial
actor
  messageType draco format dracon Dracon
  message
    fix session StatefulSession knowledge.newStatefulSession()
    mon session.set("consumer", consumer)
    mon session.insert(Seq(msg): _*)
    mon session.fire()
    mon session.close()
