type OriginateReport
domain domains terrestrial Terrestrial
rule
  pattern
    variables
      var intent MarchIntent
  action
    fix consumer (draco.format.dracon.Dracon -> ()) ctx.getRuntime().get[draco.format.dracon.Dracon => Unit]("consumer")
    fix cursor io.circe.HCursor intent.json.hcursor
    fix unit String cursor.get[String]("unit").getOrElse("UNKNOWN")
    fix elevationFeet Int cursor.get[Int]("elevationFeet").getOrElse(0)
    fix elevationMetres Int elevationFeet * 3048 / 10000
    fix payload io.circe.Json io.circe.Json.obj(("type", io.circe.Json.fromString("LOCATION")), ("unit", io.circe.Json.fromString(unit)), ("elevationMetres", io.circe.Json.fromInt(elevationMetres)))
    fix report LocationReport LocationReport(payload)
    mon consumer(report)
