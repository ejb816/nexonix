type Output
  factory ActorType
    parameters
      par consumer (draco.format.dracon.Dracon -> ())
domain domains terrestrial Terrestrial
actor
  messageType domains world World
  message
    case location Location [
      now fix payload io.circe.Json io.circe.Json.obj(("type", io.circe.Json.fromString("LOCATION")), ("latitude", io.circe.Json.fromDoubleOrNull(location.latitude)), ("longitude", io.circe.Json.fromDoubleOrNull(location.longitude)), ("elevationMetres", io.circe.Json.fromInt(location.elevationMetres)))
      now fix report LocationReport LocationReport(payload)
      mon consumer(report)
    ]
