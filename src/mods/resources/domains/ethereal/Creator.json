          "kind": "Monadic",
          "value": "session.insert(Seq(msg): _*)"
        },
        {
          "kind": "Monadic",
          "value": "session.fire()"
        },
        {
          "kind": "Monadic",
          "value": "session.close()"
        }
      ]
    }
  },
  "domainAspect": {
