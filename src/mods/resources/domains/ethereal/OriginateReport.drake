type OriginateReport
uses [
  draco format dracon Dracon
]
domain domains ethereal Ethereal
rule
  pattern
    variables
      var intent LaunchIntent
  action
    fix consumer (Dracon -> ()) ctx.getRuntime().get[draco.format.dracon.Dracon => Unit]("consumer")
    fix cursor io.circe.HCursor intent.json.hcursor
    fix obj String cursor.get[String]("object").getOrElse("UNKNOWN")
    fix altitudeNauticalMiles Int cursor.get[Int]("altitudeNauticalMiles").getOrElse(0)
    fix altitudeKilometres Int altitudeNauticalMiles * 1852 / 1000
    fix payload io.circe.Json io.circe.Json.obj(("category", io.circe.Json.fromString("EPHEMERIS")), ("object", io.circe.Json.fromString(obj)), ("altitudeKilometres", io.circe.Json.fromInt(altitudeKilometres)))
    fix report EphemerisReport EphemerisReport(payload)
    mon consumer(report)
