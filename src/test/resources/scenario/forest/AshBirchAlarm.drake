type AshBirchAlarm
domain scenario forest Forest
rule
  pattern
    variables
      var jasmonate scenario.ash.AshJasmonate
    conditions
      con jasmonate.potency.value > 0.5
  action
    fix primed scenario.birch.BirchJasmonate scenario.birch.BirchJasmonate(scenario.ash.birch.Potency(jasmonate.potency), scenario.ash.birch.Marker(jasmonate.compound))
    mon ctx.insert(primed)
