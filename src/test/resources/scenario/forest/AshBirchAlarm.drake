type AshBirchAlarm
domain scenario forest Forest
rule
  pattern
    variables
      var jasmonate scenario.ash.AshJasmonate
    conditions
      con jasmonate.potency.value > 0.5
  action
    fix primed scenario.birch.BirchJasmonate parameters
      par [ scenario.ash.birch.Potency parameters par jasmonate.potency ]
      par [ scenario.ash.birch.Marker parameters par jasmonate.compound ]
    mon ctx.insert parameters par primed
