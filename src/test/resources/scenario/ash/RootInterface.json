        {
          "kind": "Monadic",
          "value": {
            "()": [
              "session.fire"
            ]
          }
        }
      ]
    },
    "messageType": {
      "name": "AshSap",
      "namePackage": [
        "scenario",
        "ash"
      ]
    },
    "start": {
      "kind": "Action",
      "body": [
        {
          "kind": "Fixed",
          "name": "session",
          "valueType": "org.evrete.api.StatefulSession",
          "value": {
            "()": [
              "knowledge.newStatefulSession"
            ]
          }
        }
      ]
    }
  }
}
