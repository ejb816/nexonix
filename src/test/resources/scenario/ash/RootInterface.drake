type RootInterface
domain scenario ash Ash
actor
  messageType AshSap
  start
    fix session org.evrete.api.StatefulSession knowledge.newStatefulSession()
  message
    case a AlarmSignal [
      mon session.insert(Seq(a.infochemical): _*)
    ]
    case d DroughtCue [
      mon session.insert(Seq(d.infochemical): _*)
    ]
    mon session.fire()
